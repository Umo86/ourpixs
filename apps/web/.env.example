# ─── Core ──────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled). Migrations: drizzle/*.sql (npx drizzle-kit migrate).
DATABASE_URL=postgres://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Long random string (≥16 chars). Signs host JWTs (op_session cookie / Bearer) and peppers login-code hashes.
AUTH_SECRET=
# Long random string (≥16 chars). HMAC for guest device tokens, PIN proof cookies and live-wall keys.
GUEST_TOKEN_SECRET=
# Brand used when the host header matches neither domain (local dev, previews): ourpixs | bizimresimler
DEFAULT_BRAND=ourpixs
# Public base URLs per brand (used in links, QR codes, emails, Stripe redirects).
NEXT_PUBLIC_URL_EN=https://ourpixs.com
NEXT_PUBLIC_URL_TR=https://bizimresimler.com
# Support addresses shown on /support and in the footer (optional; defaults in src/lib/config.ts).
NEXT_PUBLIC_SUPPORT_EMAIL_EN=
NEXT_PUBLIC_SUPPORT_EMAIL_TR=

# ─── Email (Resend) ────────────────────────────────────────────────────
# Login codes, co-host invites, expiry warnings, report alerts. Verify both sending domains in Resend.
RESEND_API_KEY=
EMAIL_FROM_EN="Our Pixs <hello@ourpixs.com>"
EMAIL_FROM_TR="Bizim Resimler <merhaba@bizimresimler.com>"
# 1 = when RESEND_API_KEY is missing, show the login code in the UI / API (previews only; ignored when VERCEL_ENV=production).
PREVIEW_SHOW_CODE=
# App-store review account: this email signs in with this code (both must be set).
REVIEW_EMAIL=
REVIEW_CODE=

# ─── Storage (pick one) ────────────────────────────────────────────────
# Cloudflare R2 (preferred: private bucket, presigned PUT/GET, multipart > 50 MB).
# Bucket CORS must allow PUT + GET from both domains (and the Expo app), with headers Content-Type, and expose ETag.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# …or Vercel Blob (public blobs under unguessable paths). Used only when the R2_* vars are not all set.
BLOB_READ_WRITE_TOKEN=

# ─── Payments (Stripe) ─────────────────────────────────────────────────
# One-off GBP Checkout per event (prices in src/lib/config.ts PLANS, VAT included) + Partner subscription.
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<domain>/api/stripe/webhook with events:
#   checkout.session.completed, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, charge.refunded, customer.subscription.created, customer.subscription.updated,
#   customer.subscription.deleted, invoice.payment_failed
STRIPE_WEBHOOK_SECRET=
# Partner plan: create a Product "Partner" with a recurring monthly GBP price of £149 (config PARTNER_PENCE)
# in the Stripe dashboard (Products → Add product → Recurring, Monthly), then paste the price id (price_…).
# Enable the Customer portal (Settings → Billing → Customer portal) so partners can update cards / cancel.
STRIPE_PRICE_PARTNER=
# 1 = turn on Stripe Tax (automatic_tax) for the partner subscription. Optional; amounts are VAT-inclusive otherwise.
STRIPE_TAX=

# ─── Cron (Vercel) ─────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup (daily) and /api/cron/expiry (daily). See vercel.json.
CRON_SECRET=

# ─── Moderation ────────────────────────────────────────────────────────
# Optional. Enables OpenAI's free moderation endpoint (omni-moderation-latest) on uploaded photos; flagged shots go to approval.
OPENAI_API_KEY=

# ─── Mobile app ────────────────────────────────────────────────────────
# Optional Expo access token for the push API (only if "enhanced push security" is on in Expo).
EXPO_ACCESS_TOKEN=
# Universal links: Apple Team ID (apple-app-site-association) and Android signing cert SHA-256 fingerprints (comma-separated).
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=
