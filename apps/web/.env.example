# ─── Core ──────────────────────────────────────────────────────────────
# Neon Postgres connection string (pooled). Migrations: drizzle/*.sql (npx drizzle-kit migrate).
DATABASE_URL=postgres://user:pass@ep-xxx.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Long random string (≥16 chars). Signs host JWTs (op_session cookie / Bearer) and peppers login-code hashes.
AUTH_SECRET=
# Long random string (≥16 chars). HMAC for guest device tokens, PIN proof cookies and live-wall keys.
GUEST_TOKEN_SECRET=
# Brand for any host that is not bizimresimler.com / ourpixs.com or one of their subdomains
# (*.vercel.app, previews, localhost): bizimresimler (main brand) | ourpixs (English alias)
DEFAULT_BRAND=bizimresimler
# Public base URLs per brand (links, QR codes, emails, Stripe redirects). _TR = BizimResimler (main), _EN = Our Pixs (alias).
NEXT_PUBLIC_URL_TR=https://bizimresimler.com
NEXT_PUBLIC_URL_EN=https://ourpixs.com
# Superadmin dashboard (/admin): comma-separated emails of hosts who are admins (case-insensitive).
# They also receive the one-off fair-use alert email when an event passes the storage limit.
# They sign in with the normal email code; admin pages also need a sign-in from the last 12 hours.
# Empty = no admins: /admin and /api/admin/* answer 404 for everyone.
ADMIN_EMAILS=
# Support address for both brands, shown on /support, help, legal pages and the footer (optional; default hello@bizimresimler.com).
NEXT_PUBLIC_SUPPORT_EMAIL=

# ─── Email (Resend) ────────────────────────────────────────────────────
# Login codes, co-host invites, "gallery ended" and deletion-reminder emails, report and fair-use alerts.
# One sending address for both brands: only bizimresimler.com needs verifying in Resend.
RESEND_API_KEY=
# EN = sender for Our Pixs (ourpixs.com) accounts, TR = sender for BizimResimler accounts (whatever their language).
EMAIL_FROM_EN="Our Pixs <hello@bizimresimler.com>"
EMAIL_FROM_TR="BizimResimler <hello@bizimresimler.com>"
# 1 = when RESEND_API_KEY is missing, show the login code in the UI / API (previews only; ignored when VERCEL_ENV=production).
PREVIEW_SHOW_CODE=
# App-store review account: this email signs in with this code (both must be set).
REVIEW_EMAIL=
REVIEW_CODE=

# ─── Storage (pick one) ────────────────────────────────────────────────
# Cloudflare R2 (preferred: private bucket, presigned PUT/GET, multipart > 50 MB).
# Bucket CORS must allow PUT + GET from both domains (bizimresimler.com, ourpixs.com + www) (and the Expo app), with headers Content-Type, and expose ETag.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# …or Vercel Blob (public blobs under unguessable paths). Used only when the R2_* vars are not all set.
BLOB_READ_WRITE_TOKEN=

# ─── Payments (Stripe) ─────────────────────────────────────────────────
# Event package: one payment per event (default £69, GBP, VAT included; editable on /admin/settings,
# defaults in src/lib/config.ts PACKAGE_DEFAULTS). Checkout (mode "payment") uses an inline price, so no Stripe
# products need to be created. TEST KEYS ONLY (sk_test_…) until live payments are approved.
# Missing key = "Payments coming soon".
STRIPE_SECRET_KEY=
# Webhook endpoint: https://<domain>/api/stripe/webhook with events:
#   checkout.session.completed, checkout.session.async_payment_succeeded, charge.refunded
# See docs/SETUP.md.
STRIPE_WEBHOOK_SECRET=

# ─── Cron (Vercel) ─────────────────────────────────────────────────────
# Vercel sends "Authorization: Bearer $CRON_SECRET" to /api/cron/expiry (daily: "gallery ended" emails + deletion
# reminders 30/7 days before) and /api/cron/cleanup (daily: deletes files of events past retention, purges abandoned
# uploads). See vercel.json.
CRON_SECRET=

# ─── Moderation ────────────────────────────────────────────────────────
# Optional. Enables OpenAI's free moderation endpoint (omni-moderation-latest) on uploaded photos; flagged shots go to approval.
OPENAI_API_KEY=

# ─── Mobile app ────────────────────────────────────────────────────────
# Optional Expo access token for the push API (only if "enhanced push security" is on in Expo).
EXPO_ACCESS_TOKEN=
# Universal links: Apple Team ID (apple-app-site-association) and Android signing cert SHA-256 fingerprints (comma-separated).
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=
