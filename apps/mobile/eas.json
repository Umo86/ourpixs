{
  "cli": {
    "version": ">= 16.0.1",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.23.4",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://bizimresimler.com",
        "EXPO_PUBLIC_BRAND": "bizimresimler"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "development",
        "EXPO_PUBLIC_SHOW_PREVIEW_CODE": "1",
        "EXPO_PUBLIC_EXTERNAL_CHECKOUT": "1"
      },
      "ios": {
        "simulator": false
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_SHOW_PREVIEW_CODE": "1",
        "EXPO_PUBLIC_EXTERNAL_CHECKOUT": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "screenshots": {
      "extends": "preview",
      "env": {
        "APP_VARIANT": "preview",
        "EXPO_PUBLIC_DEMO": "1",
        "EXPO_PUBLIC_EXTERNAL_CHECKOUT": "0"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "production",
        "EXPO_PUBLIC_EXTERNAL_CHECKOUT": "0"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APPLE_ID",
        "appleTeamId": "REPLACE_WITH_APPLE_TEAM_ID"
      },
      "android": {
        "serviceAccountKeyPath": "./google-service-account.json",
        "track": "internal",
        "releaseStatus": "draft"
      }
    }
  }
}
